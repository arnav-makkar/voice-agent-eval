# Voice Agents API credentials. Never commit the real key.
SARVAM_VOICE_AGENTS_API_KEY=
# Separate standard Sarvam speech key used by Bulbul v3 caller synthesis.
SARVAM_API_KEY=

# Identifiers generated by Indus -> Deploy with code -> Instant outbound.
SARVAM_ORG_ID=019fe148-1997-7cc7-bb7a-8029929d4008
SARVAM_WORKSPACE_ID=019fe148-199b-787e-b8d7-b0c2d4e6acda
SARVAM_APP_ID=Conversatio-87b9b435-b466
SARVAM_APP_VERSION=10
SARVAM_CONNECTION_ID=447935f5-f1-05fb7f39-88f4

# Keep phone numbers local. Use the exact formats shown by the Indus recipe.
SARVAM_AGENT_PHONE_NUMBER=
SARVAM_TEST_USER_PHONE_NUMBER=

# EVA realtime caller (ElevenLabs ElevenAgents). The caller agent ID can be
# provisioned by scripts/provision_eva_elevenlabs_caller.py.
ELEVENLABS_API_KEY=
EVA_EN_USER_M=

# Semantic judges used by the EVA-derived scorers and GEPA feedback.
GEMINI_API_KEY=

# Authenticated, scenario-isolated execution-truth service. Generate a new
# random secret locally; never commit the value. The base URL is local for the
# EVA adapter, while the Indus API-tool configuration uses its public HTTPS URL.
AGENT_TOOL_SECRET=
AGENT_TOOL_BASE_URL=http://127.0.0.1:8788
AGENT_TOOL_DB=artifacts/tool_service/tools.db
