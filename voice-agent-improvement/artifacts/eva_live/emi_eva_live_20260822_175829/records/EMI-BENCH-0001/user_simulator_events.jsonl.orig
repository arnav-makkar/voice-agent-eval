{"timestamp": 1787401717000, "sequence": 14, "type": "assistant_speech", "data": {"text": "नवसिंह, क्या नावजी से बात कर रहा हूँ।", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787401721000, "sequence": 15, "type": "user_speech", "data": {"text": "[confused] Arnav bol raha hoon. Kaun hai aap?", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787401725000, "sequence": 16, "type": "assistant_speech", "data": {"text": "मैं इज़ी करेक्ट से शुभ बात कर रहा हूँ। ये call आपके Samsung Smart TV के Audio-EMI के बारे में है, जो 4,416 रुपए है। क्या आप अभी official इज़ी क्रेडिट app के ज़रिए payment कर सकते हैं?", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787401736000, "sequence": 17, "type": "user_speech", "data": {"text": "[annoyed] Haan, main abhi karta hoon. App khol raha hoon.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787401740000, "sequence": 18, "type": "assistant_speech", "data": {"text": "बहुत अच्छा। Payment होने के बाद मुझे बता दीजिएगा।", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787401743000, "sequence": 19, "type": "user_speech", "data": {"text": "[calm] Theek hai, main karta hoon aur bata deta hoon. Bye.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787401749000, "sequence": 20, "type": "assistant_speech", "data": {"text": "धन्यवाद, अरुण जी। आपका दिन शुभ �", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
