{"timestamp": 1787402853000, "sequence": 21, "type": "assistant_speech", "data": {"text": "ठीक है, तो आप 28 अगस्त को payment कर दें।", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
