{"timestamp": 1787403588000, "sequence": 15, "type": "assistant_speech", "data": {"text": "नवती, क्या नवती से बात कर रहा हूँ", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787403593000, "sequence": 16, "type": "user_speech", "data": {"text": "[confused] Haan, main hi Arnav bol raha hoon. Boliye, kaun hai aap?", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787403598000, "sequence": 17, "type": "assistant_speech", "data": {"text": "मैं इसी क्रेडिट से शुभारंभ कर रहा हूँ। आपके Samsung Smart TV की 4,416 रुपये की EMI overdue है। क्या आप अभी official app के ज़रिए payment कर सकते हैं?", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787403609000, "sequence": 18, "type": "user_speech", "data": {"text": "[annoyed] Suno, aaj main pay nahi kar sakta. Mere paas abhi paise nahi hain. Salary 28 August ko aayegi, tab main pay kar dunga.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787403618000, "sequence": 19, "type": "assistant_speech", "data": {"text": "ठीक है, तो क्या मैं 28 अगस्त के बीच record कर लूँ?", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787403621000, "sequence": 20, "type": "user_speech", "data": {"text": "[annoyed] Haan, 28 August. Bas. Aur koi date nahi.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787403626000, "sequence": 21, "type": "assistant_speech", "data": {"text": "Dene wala hai, mere se.", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787403629000, "sequence": 22, "type": "user_speech", "data": {"text": "[impatient] Haan, 28 August. Bas record kar lo.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787403633000, "sequence": 23, "type": "assistant_speech", "data": {"text": "मैंने 28 August की date record कर ली है। धन्यवाद। और", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787403654348, "sequence": 24, "type": "connection_state", "data": {"state": "session_ended", "details": {"reason": "assistant_completed"}}, "provider": "elevenlabs"}
