{"timestamp": 1787403827000, "sequence": 12, "type": "assistant_speech", "data": {"text": "नवदीप, क्या नावजी से बात कर रहा हूँ।", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787403831000, "sequence": 13, "type": "user_speech", "data": {"text": "[confused] Arnav bol raha hoon, aapne galat number dial kiya hai.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787403835000, "sequence": 14, "type": "assistant_speech", "data": {"text": "Shama Keji, par kya aap Arnav ji hi hain?", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787403839000, "sequence": 15, "type": "user_speech", "data": {"text": "Haan, main Arnav hoon. Par abhi main driving kar raha hoon, baat nahi kar sakta. Please kal subah mujhe call back karein.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787403848000, "sequence": 16, "type": "assistant_speech", "data": {"text": "ठीक है, मैं आपको कल सुबह call कर लूँगा। क्या सुबह 10:00 बजे का time सही रहेगा?", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787403853000, "sequence": 17, "type": "user_speech", "data": {"text": "[annoyed] Haan, kal subah 10 baje theek hai. Please usi time call karna. Abhi main driving kar raha hoon, bye.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787403861000, "sequence": 18, "type": "assistant_speech", "data": {"text": "ठीक है, अनाउज़", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787403879246, "sequence": 19, "type": "connection_state", "data": {"state": "session_ended", "details": {"reason": "assistant_completed"}}, "provider": "elevenlabs"}
