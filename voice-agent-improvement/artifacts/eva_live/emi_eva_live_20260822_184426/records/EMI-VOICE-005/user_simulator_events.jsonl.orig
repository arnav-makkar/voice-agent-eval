{"timestamp": 1787404547000, "sequence": 10, "type": "assistant_speech", "data": {"text": "नवसिंह, क्या नावजी से बात कर रहा हूँ।", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787404552000, "sequence": 11, "type": "user_speech", "data": {"text": "[confused] Arnav bol raha hoon, aapne mujhe galat samjha.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787404557000, "sequence": 12, "type": "assistant_speech", "data": {"text": "नमस्ते अनु जी, मैं Easy Credit से शुभ बात कर रहा हूँ। आपके Samsung Smart TV की 4,416 रुपये की EMI overdue है। क्या आप अभी official app के ज़रिए payment कर सकते हैं?", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787404568000, "sequence": 13, "type": "user_speech", "data": {"text": "[angry] Suno, maine ye TV kabhi nahi khareeda, ye loan mere naam par nahi hai. Mujhse paise mat maango, dispute record karo aur recovery calls band karo.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787404579000, "sequence": 14, "type": "assistant_speech", "data": {"text": "ठीक है, अर्नव जी, मैंने आपका dispute record कर लिया है।", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787404584000, "sequence": 15, "type": "user_speech", "data": {"text": "[relieved] Theek hai, ab call mat karna. Goodbye.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787404605822, "sequence": 16, "type": "connection_state", "data": {"state": "session_ended", "details": {"reason": "goodbye"}}, "provider": "elevenlabs"}
