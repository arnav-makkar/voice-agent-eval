{"timestamp": 1787503793000, "sequence": 13, "type": "assistant_speech", "data": {"text": "नवसिंह, क्या नावजी से बात कर रहा हूँ।", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787503797000, "sequence": 14, "type": "user_speech", "data": {"text": "[confused] Sorry, I think you have the wrong number. I am Arnav.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787503802000, "sequence": 15, "type": "assistant_speech", "data": {"text": "I am Shubh from Easy Credit. This is about the overdue EMI of 4,416 rupees for your Samsung Smart TV. Can you pay this now through the official Easy Credit app?", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787503812000, "sequence": 16, "type": "user_speech", "data": {"text": "[annoyed] Look, I am driving right now and cannot talk. Please call me back tomorrow morning.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787503818000, "sequence": 17, "type": "assistant_speech", "data": {"text": "Sure. What time tomorrow morning should I call you back?", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787503820000, "sequence": 18, "type": "user_speech", "data": {"text": "Call me back tomorrow morning between nine and ten.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787503826000, "sequence": 19, "type": "assistant_speech", "data": {"text": "Okay, I will call you tomorrow between nine and 10:00 AM.", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787503831000, "sequence": 20, "type": "user_speech", "data": {"text": "Thanks. Please call me tomorrow morning between nine and ten. I have to go now.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787503837000, "sequence": 21, "type": "assistant_speech", "data": {"text": "Thank you, Arunachal. Have a safe", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
