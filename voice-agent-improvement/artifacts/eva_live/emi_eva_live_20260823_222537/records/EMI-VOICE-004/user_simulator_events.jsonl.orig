{"timestamp": 1787504144000, "sequence": 12, "type": "assistant_speech", "data": {"text": "नवती, क्या नवती से बात कर रहा हू�", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787504149000, "sequence": 13, "type": "user_speech", "data": {"text": "[confused] Arnav bol raha hoon. Aap shubh hain na?", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787504152000, "sequence": 14, "type": "assistant_speech", "data": {"text": "हाँ जी, मैं Easy Credit से शुभ बात कर रहा हूँ। आपके Samsung Smart TV की 4,416 रुपये की EMI overdue है। क्या आप अभी official Easy Credit app के ज़रिए payment कर सकते हैं?", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787504163000, "sequence": 15, "type": "user_speech", "data": {"text": "[direct] Nahi, main is mahine payment nahi karunga.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787504168000, "sequence": 16, "type": "assistant_speech", "data": {"text": "ठीक है, मैं आपका response note कर लेता हूँ। धन्यवाद अर्नव जी।", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787504174000, "sequence": 17, "type": "user_speech", "data": {"text": "[neutral] Theek hai, bye.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787504177000, "sequence": 18, "type": "assistant_speech", "data": {"text": "धन्यवाद, अनन्त जी। आपक", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
