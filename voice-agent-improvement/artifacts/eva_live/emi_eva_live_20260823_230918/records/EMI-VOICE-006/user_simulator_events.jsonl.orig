{"timestamp": 1787506765000, "sequence": 15, "type": "assistant_speech", "data": {"text": "नवदीप, क्या नावजी से बात कर रहा हूँ।", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787506769000, "sequence": 16, "type": "user_speech", "data": {"text": "[confused] Arnav bol raha hoon, Navdeep nahi. Bataiye kya baat hai?", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787506773000, "sequence": 17, "type": "assistant_speech", "data": {"text": "नमस्ते अन्ना जी, मैं Easy Credit से शुभ बात कर रहा हूँ। आपके Samsung Smart TV की 4,416 रुपये की EMI overdue है। क्या आप अभी official Easy Credit app के ज़रिए payment कर सकते हैं?", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787506786000, "sequence": 18, "type": "user_speech", "data": {"text": "[frustrated] Suniye, mujhe abhi paise dene ki halat nahi hai. Mera job chala gaya hai aur papa hospital mein hain. Main abhi payment nahi kar sakta.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787506796000, "sequence": 19, "type": "assistant_speech", "data": {"text": "मुझे ये सुनकर बहुत दुख हुआ। आप कृपया customer care number 18005004444 पर बात करें और अ", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787506819162, "sequence": 20, "type": "connection_state", "data": {"state": "session_ended", "details": {"reason": "assistant_completed"}}, "provider": "elevenlabs"}
