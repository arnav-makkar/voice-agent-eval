{"timestamp": 1787507080000, "sequence": 13, "type": "assistant_speech", "data": {"text": "नवती, क्या नवती से बात कररहा हूँ?", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787507085000, "sequence": 14, "type": "user_speech", "data": {"text": "जी हाँ, मैं Arnav bol raha hoon. Jiye, kya baat hai?", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787507090000, "sequence": 15, "type": "assistant_speech", "data": {"text": "मैं easy credit से शुभारंभ कर रहा हूँ। आपके Samsung Smart TV की 4,416 रुपये की EMI overdue है। क्या आप अभी official easy credit app के ज़रिए payment कर सकते हैं?", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787507101000, "sequence": 16, "type": "user_speech", "data": {"text": "[annoyed] Suniye, mujhe abhi payment karne ki koi halat nahi hai. Mera job chala gaya hai aur mere father hospital mein hain. Main abhi ye baat nahi kar sakta.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787507112000, "sequence": 17, "type": "assistant_speech", "data": {"text": "मुझे ये सुनकर बहुत दुख हुआ। आप कृपया customer care number 18005004444 पर बात क", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
