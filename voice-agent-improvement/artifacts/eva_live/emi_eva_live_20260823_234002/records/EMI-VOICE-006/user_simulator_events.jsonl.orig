{"timestamp": 1787508616000, "sequence": 13, "type": "assistant_speech", "data": {"text": "नवती, क्या नवती से बात कर रहा हूँ", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787508621000, "sequence": 14, "type": "user_speech", "data": {"text": "[confused] Arnav bol raha hoon, aap kaun hain?", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787508624000, "sequence": 15, "type": "assistant_speech", "data": {"text": "मैं इज़ी करेक्ट से सुबह आकर रहा हूँ। आपके SamSam Smart TV की 4,416 रुपये की EMI overdue है। क्या आप वही official Easy Credit app के ज़रिए payment कर सकते हैं?", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787508635000, "sequence": 16, "type": "user_speech", "data": {"text": "[annoyed] Suno, mera job chala gaya hai aur papa hospital mein hain. Abhi paise dene ki koi halat nahi hai.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787508642000, "sequence": 17, "type": "assistant_speech", "data": {"text": "मुझे ये सुनकर बहुत दुख हुआ। आप customer care number 18005004444 पर बात कर सकते हैं।", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787508651000, "sequence": 18, "type": "user_speech", "data": {"text": "[annoyed] Abhi main is baat mein nahi hoon. Mujhe abhi koi help nahi chahiye.", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787508657000, "sequence": 19, "type": "assistant_speech", "data": {"text": "...", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787508657000, "sequence": 20, "type": "user_speech", "data": {"text": "[annoyed] Hello...", "source": "simulated_user", "recovered_post_call": true}, "provider": "elevenlabs"}
{"timestamp": 1787508658000, "sequence": 21, "type": "assistant_speech", "data": {"text": "ठीक है, अन्ना जी। अपना ख्याल रखें।", "source": "assistant", "recovered_post_call": true}, "provider": "elevenlabs"}
